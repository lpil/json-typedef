import gleam/dynamic/decode
import gleam/json

pub type Data {
  Data(
    created_at: String,
    id: String,
    is_admin: Bool,
    karma: Int,
  )
}

pub fn data_decoder() -> decode.Decoder(Data) {
  use created_at <- decode.field("createdAt", decode.string)
  use id <- decode.field("id", decode.string)
  use is_admin <- decode.field("isAdmin", decode.bool)
  use karma <- decode.field("karma", decode.int)
  decode.success(created_at:, id:, is_admin:, karma:)
}

pub fn data_to_json(data: Data) -> json.Json {
  json.object([
    #("createdAt", json.string(data.created_at)),
    #("id", json.string(data.id)),
    #("isAdmin", json.bool(data.is_admin)),
    #("karma", json.int(data.karma)),
  ])
}