import gleam/dynamic/decode
import gleam/json
import gleam/option

pub fn data_decoder() -> decode.Decoder(option.Option(Int)) {
  decode.optional(decode.int)
}

pub fn data_to_json(data: option.Option(Int)) -> json.Json {
  json.nullable(data, json.int)
}