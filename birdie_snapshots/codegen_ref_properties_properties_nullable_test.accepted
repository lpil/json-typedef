import gleam/dynamic/decode
import gleam/json

pub type Data {
  Data(
    inner: wibble,
  )
}

pub type Wibble {
  Wibble(
    count: Int,
  )
}

pub fn data_decoder() -> decode.Decoder(Data) {
  use inner <- decode.field("inner", wibble_decoder())
  decode.success(inner:)
}

pub fn data_to_json(data: Data) -> json.Json {
  json.object([
    #("inner", wibble_to_json(data.inner)),
  ])
}