import gleam/dynamic/decode
import gleam/json
import gleam/option

pub type Data {
  Data(
    amount: Int,
    key: option.Option(String),
  )
}

pub fn data_decoder() -> decode.Decoder(Data) {
  use amount <- decode.field("amount", decode.int)
  use key <- decode.field("key", decode.optional(decode.string))
  decode.success(amount:, key:)
}

pub fn data_to_json(data: Data) -> json.Json {
  json.object([
    #("key", json.nullable(data.key, json.string)),
    #("amount", json.int(data.amount)),
  ])
}